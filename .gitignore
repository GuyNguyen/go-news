# Generated by Cargo
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Environment and sensitive files
.env
config.toml
notes.md

# SQLite database files and persistent data
data/
*.db
*.db-wal
*.db-shm

# Log files
*.log

# Docker image tarballs
*.tar
*.tar.gz

# Local uncommitted AI gitignore file
.gitignore.ai